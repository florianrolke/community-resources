# Copy to .env and fill in. .env is gitignored — keep it that way.

# Optional. LinkedIn profile matching. Free tier, no card: https://exa.ai
EXA_API_KEY=

# Optional. Finding decision-makers inside companies, and the fallback engine
# for LinkedIn matching when Exa runs dry.
# Free tier, 1,000 searches/month, no card: https://tavily.com
TAVILY_API_KEY=

# Add numbered keys to raise your monthly ceiling. When one is spent, the
# scripts retire it and rotate to the next one mid-run — no restart, no lost
# progress. Recognised up to _20 for both services. See linkedin.md.
# EXA_API_KEY_2=
# EXA_API_KEY_3=
# TAVILY_API_KEY_2=
# TAVILY_API_KEY_3=

# Optional. Email discovery + SMTP verification (the only paid layer).
APIFY_API_TOKEN=

# The scraper and the binder builder need NONE of these.
