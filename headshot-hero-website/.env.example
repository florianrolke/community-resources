# ─────────────────────────────────────────────
# headshot-hero-website — environment variables
# Copy to .env and fill in your values.
# Never commit .env to git.
# ─────────────────────────────────────────────

# Replicate — runs Real-ESRGAN (upscale), Flux Fill Dev (outpaint), rembg (background removal)
# Get yours at https://replicate.com
REPLICATE_API_TOKEN=r8_...

# Firecrawl — scrapes the prospect's website to find their photo + branding
# Get yours at https://firecrawl.dev
FIRECRAWL_API_KEY=fc-...

# Anthropic — used by full_transformation.py for copy generation
ANTHROPIC_API_KEY=sk-ant-...

# OpenRouter (optional fallback LLM)
OPENROUTER_API_KEY=sk-or-...

# GitHub — push generated HTML to deploy repo (Contents: read & write)
GITHUB_TOKEN=github_pat_...

# Coolify — deploy to your hosting server
COOLIFY_API_TOKEN=...
COOLIFY_API_URL=https://app.coolify.io

# Cloudflare — create DNS records for new subdomains
CLOUDFLARE_API_TOKEN=...
CLOUDFLARE_ZONE_ID=...

# Preview domain for deployed pages
PREVIEW_DOMAIN=preview.yourdomain.com
