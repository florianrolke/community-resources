APP_NAME=meeting-intelligence
HOST_NAME=Your Name
HOST_EMAIL=you@example.com
PUBLIC_BASE_URL=http://localhost:8080
DATA_DIR=data

# Fathom
FATHOM_API_KEY=
FATHOM_WEBHOOK_SECRET=
FATHOM_POLL_MINUTES=15

# Summary LLM: gemini, openai, or fallback
LLM_PROVIDER=gemini
GOOGLE_API_KEY=
GEMINI_SUMMARY_MODEL=gemini-1.5-flash
OPENAI_API_KEY=
OPENAI_SUMMARY_MODEL=gpt-4o-mini

# Google Docs / Gmail / Calendar are optional.
GOOGLE_DOCS_ENABLED=false
GMAIL_DRAFTS_ENABLED=false
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_DOCS_TOKEN_JSON=
GOOGLE_GMAIL_TOKEN_JSON=
GOOGLE_CALENDAR_TOKEN_JSON=
GOOGLE_DOCS_TEMPLATE_ID=
GOOGLE_DRIVE_FOLDER_ID=

# Neo4j vectorization
NEO4J_ENABLED=true
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=meeting-intelligence-password
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
CHUNK_WORDS=420
CHUNK_OVERLAP_WORDS=60

# Config files
CONTACTS_PATH=data/config/contacts.json
STYLE_POLICY_PATH=data/config/email_style_policy.json
DOC_CONFIG_PATH=data/config/google_doc_config.json
NEXT_MEETING_DAYS=7
