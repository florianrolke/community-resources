# Copy to .env and fill in. .env is gitignored — never commit real keys.

# ---- Required: Fish Audio (voice cloning + TTS) -----------------------------
# Sign up at https://fish.audio, then Developer -> API Keys -> Create API Key.
# NOTE: API billing is separate from the fish.audio subscription plans. Buying a
# Plus/Pro plan does NOT enable the API. Top up under Developer -> Balance.
# The free model `s2.1-pro-free` works on a zero balance AND accepts a cloned
# voice reference_id, so cloned narration can cost nothing.
FISH_AUDIO_API_KEY=

# ---- Optional: remote render / transcription box ---------------------------
# Only needed for `build_vo_edit.py --remote` and whisper_hostinger_client.py.
# Leave blank to run everything locally.
REMOTE_SSH_HOST=user@your.server.ip
REMOTE_SSH_KEY=~/.ssh/your_key

# ---- Optional: AI video generation for extra b-roll ------------------------
# Any provider hosting a video model (Seedance, Kling, etc). Not used by the
# core pipeline — b-roll is registered from files on disk via register_broll.py.
VIDEO_GEN_API_KEY=
