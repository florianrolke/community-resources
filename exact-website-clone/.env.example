# ─────────────────────────────────────────────
# exact-website-clone — environment variables
# Copy this to .env and fill in your values.
# Never commit .env to git.
# ─────────────────────────────────────────────

# Firecrawl — used by clone_website.py to scrape prospect sites
# Get yours at https://firecrawl.dev
FIRECRAWL_API_KEY=fc-...

# GitHub — personal access token with Contents: read & write for your deploy repo
# Fine-grained PAT: https://github.com/settings/tokens?type=beta
GITHUB_TOKEN=github_pat_...

# Coolify — API token from your Coolify instance (Settings → API)
COOLIFY_API_TOKEN=...
COOLIFY_API_URL=https://app.coolify.io

# Cloudflare — zone-scoped API token (Edit zone DNS permission)
# Zone ID is on the Overview page of your domain in the Cloudflare dashboard
CLOUDFLARE_API_TOKEN=...
CLOUDFLARE_ZONE_ID=...

# Preview domain (change if you use a different domain)
PREVIEW_DOMAIN=preview.yourdomain.com
