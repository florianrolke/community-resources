# ============================================================================
#  UNLIMITED Leads — environment variables
# ============================================================================
#  Copy this file to `.env` (same folder) and paste your keys in.
#
#      Windows:  copy .env.example .env
#      Mac/Linux: cp .env.example .env
#
#  Then check it worked:
#
#      python -X utf8 scripts/check_setup.py
#
#  You do NOT need all of these. System 3 needs zero keys. Systems 1 and 2
#  need two keys between them. Everything else is optional.
# ============================================================================


# ── REQUIRED for System 1 and System 2 ──────────────────────────────────────
# Apify runs the scrapers. Sign up: https://console.apify.com/sign-up
# Free trial credit included; after that ~$1.50 per 1,000 B2B contacts and
# ~$4 per 1,000 Google Maps places. Get the token from:
#   Settings -> API & Integrations -> Personal API tokens
APIFY_API_TOKEN=


# ── REQUIRED for research + outreach writing ────────────────────────────────
# Claude does the lead research and writes the subject lines / openers.
# Sign up: https://console.anthropic.com  (pay as you go, ~$0.01-0.03 per lead)
ANTHROPIC_API_KEY=


# ── RECOMMENDED — free tier, big quality jump ───────────────────────────────
# Tavily is the web-search tool the research agent uses to find trigger events.
# Sign up: https://tavily.com  — 1,000 searches/month free, no card required.
TAVILY_API_KEY=


# ── OPTIONAL — more research depth ──────────────────────────────────────────
# Exa is a second search engine. Free tier: 1,000 searches/month.
# Sign up: https://exa.ai
EXA_API_KEY=


# ── OPTIONAL — find emails you don't already have ───────────────────────────
# AnyMailFinder bulk-finds emails from company + person name.
# Sign up: https://anymailfinder.com — 50 free credits.
ANYMAILFINDER_API_KEY=


# ── OPTIONAL — Google Sheets output ─────────────────────────────────────────
# You do NOT need this. CSV is the default and works out of the box.
# Only set this up if you want leads pushed straight into a Sheet.
# Full walkthrough: docs/GOOGLE_SHEETS_SETUP.md
GOOGLE_APPLICATION_CREDENTIALS=credentials.json


# ── OPTIONAL — your details, used when writing outreach ─────────────────────
# Saves you passing --sender-name on every command.
OUTREACH_SENDER_NAME=
OUTREACH_SENDER_EMAIL=
