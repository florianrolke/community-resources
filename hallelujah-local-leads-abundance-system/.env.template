# ============================================================================
# Hallelujah Local Leads Abundance System — Environment Variables
# ============================================================================
# Copy this file to .env and fill in your API keys.
# Not all keys are required — see comments for which pillars need which keys.

# ── REQUIRED: Enrichment Engine (Pillar 4) ──────────────────────────────────
# At minimum, you need ONE Exa key to enrich leads with LinkedIn/websites.
# More keys = more monthly quota (each key gets 1000 searches/month).

EXA_API_KEY=           # exa.ai — primary enrichment engine
EXA_API_KEY_2=         # optional rotation key
EXA_API_KEY_3=         # optional rotation key
EXA_API_KEY_4=         # optional rotation key
EXA_API_KEY_5=         # optional rotation key
EXA_API_KEY_6=         # optional rotation key

# ── RECOMMENDED: Tavily (fallback for Exa) ──────────────────────────────────
# tavily.com — 1000 searches/month per key. Used as fallback when Exa exhausted.

TAVILY_API_KEY=        # primary
TAVILY_API_KEY_2=      # optional rotation
TAVILY_API_KEY_3=      # optional rotation
TAVILY_API_KEY_4=      # optional rotation
TAVILY_API_KEY_5=      # optional rotation
TAVILY_API_KEY_6=      # optional rotation

# ── OPTIONAL: Perplexity (deep research) ────────────────────────────────────
# perplexity.ai — used for company research + BNI chapter discovery.
# Pay-per-query. Not required but significantly improves enrichment quality.

PERPLEXITY_API_KEY=

# ── MAGAZINE + WEBSITE PILLARS ─────────────────────────────────────────────
# Firecrawl: used for Issuu screenshots (magazine) + website capture (website redesign)
# Anthropic: used for ad detection (magazine) + redesign generation (website)

FIRECRAWL_API_KEY=     # firecrawl.dev — 500 credits/month
ANTHROPIC_API_KEY=     # anthropic.com — Claude for vision AI + redesign generation

# ── WEBSITE REDESIGN PILLAR ONLY ──────────────────────────────────────────
# GitHub deployment for live preview URLs (optional — local preview works without it)

GITHUB_TOKEN=          # github.com — for deploying redesigns to GitHub Pages
DEPLOY_GITHUB_REPO=    # e.g. your-username/redesigns — the repo for deployed previews

# ── VISION API FALLBACK (magazine + website) ──────────────────────────────
# OpenRouter: fallback when Anthropic credits are exhausted. Routes to same
# Claude Haiku model via openrouter.ai. Pay-per-use, no monthly limits.

OPENROUTER_API_KEY=    # openrouter.ai — fallback for vision API when Anthropic exhausted

# ── OUTREACH PILLAR (Pillar 6) ────────────────────────────────────────────
# CapSolver: solves reCAPTCHA v2/v3, hCaptcha, Cloudflare Turnstile on contact forms.
# Playwright: auto-fills and submits contact forms on chamber + business websites.

CAPSOLVER_API_KEY=     # capsolver.com — CAPTCHA solving for form submissions
OUTREACH_NAME=         # Your name (used in form submissions)
OUTREACH_EMAIL=        # Your email (used in form submissions)
OUTREACH_PHONE=        # Your phone (optional, for forms that require it)
OUTREACH_COMPANY=      # Your company name (optional)

# ── EMAIL VERIFICATION (optional) ───────────────────────────────────────────
# Self-hosted Reacher instance for SMTP email verification.
# If you don't have one, email verification is skipped gracefully.

REACHER_API_URL=       # e.g. https://reacher.yourdomain.com
REACHER_API_KEY=       # optional auth key for your Reacher instance

# ── GMAIL INTEGRATION (optional) ────────────────────────────────────────────
# Only needed if you want to auto-create Gmail drafts for outreach.
# Requires OAuth credentials — see docs/GMAIL_SETUP.md

# GMAIL_TOKEN_PATH=    # path to token_gmail.json
